{
  "name": "cognitron",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "server": "node server/dev.js",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start:api": "node server/index.js",
    "start": "vite build && node server/dev.js --serve",
    "backup": "node -e \"import('./server/store.js').then(async m=>{const s=await m.openStore('server/data');console.log('Backup saved:',s.backup('manual'));s.close()})\""
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "express": "^4.22.3",
    "gsap": "^3.13.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "postprocessing": "^6.37.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-loading-indicators": "^1.0.1",
    "react-social-icons": "^6.24.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "vite": "^5.2.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
